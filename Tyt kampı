              <span class="font-mono text-slate-400 font-semibold shrink-0 text-[11px]">${b.time}</span>
              <span class="text-white font-medium">${b.title}</span>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded-md border ${b.color} self-start sm:self-auto font-semibold">
              ${b.tag}
            </span>
          </div>
        `).join('');

        blockWrapper.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-[#1e2c47]/60">
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-white">${sched.dayName}</span>
              <span class="text-[10px] px-2 py-0.5 rounded border ${sched.fitnessColor} font-semibold">${sched.fitnessBadge}</span>
            </div>
            ${sched.specialBadge ? `<span class="text-[10px] px-2 py-0.5 rounded border ${sched.specialColor} font-semibold">${sched.specialBadge}</span>` : ''}
          </div>
          <div class="space-y-1.5">
            ${blocksHtml}
          </div>
        `;
        container.appendChild(blockWrapper);
      });
    }

    function shareHourlyScheduleTelegram() {
      let text = `🏋️‍♂️ *11. SINIF SPOR & TYT SAATLİK RUTİN*\n\n`;
      weeklyFixedSchedule.forEach(s => {
        text += `📌 *${s.dayName}* (${s.fitnessBadge}):\n`;
        s.routineBlocks.forEach(b => {
          text += `  • ${b.time} -> ${b.title}\n`;
        });
        text += `\n`;
      });
      window.open(`https://t.me/share/url?url=${encodeURIComponent(window.location.href)}&text=${encodeURIComponent(text)}`, '_blank');
      showToast("✈️ Saatlik rutin Telegram'a aktarılıyor...");
    }

    function buildFullRoadmapModal() {
      const container = document.getElementById('roadmap-table-content');
      if (!container) return;
      container.innerHTML = '';

      macroPhases.forEach(phase => {
        const phaseDiv = document.createElement('div');
        phaseDiv.className = "bg-[#0b101c] border border-[#1e2c47] rounded-2xl p-4 space-y-3";

        let weeksHtml = '';
        phase.weeks.forEach(wNum => {
          const wData = weeksDatabase.find(w => w.weekNum === wNum);
          if (!wData) return;
          weeksHtml += `
            <div onclick="selectWeekFromRoadmap(${wNum})" class="p-3 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-[#1e2c47] hover:border-sky-500/40 cursor-pointer transition flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <div class="font-bold text-slate-200 text-xs">${wData.title}</div>
                <div class="text-[11px] text-slate-400 mt-0.5 line-clamp-1">${wData.desc}</div>
              </div>
              <span class="text-[10px] text-sky-400 font-semibold px-2 py-1 rounded-lg bg-sky-500/10 border border-sky-500/20 shrink-0 self-start sm:self-auto">
                Bu Haftaya Git ➔
              </span>
            </div>
          `;
        });

        phaseDiv.innerHTML = `
          <div class="flex items-center gap-2 pb-2 border-b border-[#1e2c47]/70">
            <span class="text-[11px] uppercase tracking-wider font-extrabold px-2.5 py-0.5 rounded-md border ${phase.color}">
              ${phase.name}
            </span>
          </div>
          <div class="space-y-2">
            ${weeksHtml}
          </div>
        `;
        container.appendChild(phaseDiv);
      });
    }

    function selectWeekFromRoadmap(weekNum) {
      toggleModal('full-roadmap-modal');
      loadWeek(weekNum);
      showToast(`🗓️ Hafta ${weekNum} görüntülendi.`);
    }

    function renderNotes() {
      const container = document.getElementById('notes-container');
      const countEl = document.getElementById('saved-notes-count');
      if (!container || !countEl) return;
      container.innerHTML = '';
      countEl.innerText = `${notesDatabase.length} Not`;

      if (notesDatabase.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-slate-500 text-xs border border-dashed border-[#1e2c47] rounded-xl">
            Henüz eklenmiş analiz yok. Denemelerde takıldığın soruları buraya kaydet.
          </div>
        `;
        return;
      }

      notesDatabase.slice().reverse().forEach((note, index) => {
        const actualIdx = notesDatabase.length - 1 - index;
        const div = document.createElement('div');
        div.className = "bg-[#0b101c] border border-[#1e2c47] rounded-xl p-3.5 flex flex-col justify-between gap-2 text-xs";
        div.innerHTML = `
          <div>
            <div class="flex justify-between items-start gap-2 mb-1">
              <span class="font-bold text-sky-400">${escapeHtml(note.topic)}</span>
              <span class="text-[10px] text-slate-500">${note.date}</span>
            </div>
            <p class="text-slate-300 leading-relaxed">${escapeHtml(note.body)}</p>
          </div>
          <div class="flex justify-between items-center pt-2 border-t border-[#1e2c47]/70">
            <button onclick="shareSingleNoteTelegram(${actualIdx})" class="text-[#229ED9] hover:underline text-[11px] flex items-center gap-1 font-medium">
              <span>✈️</span> Telegram'a Gönder
            </button>
            <button onclick="deleteNote(${actualIdx})" class="text-rose-400 hover:text-rose-300 text-[11px]">Sil</button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function addMistakeNote() {
      const tInput = document.getElementById('note-topic-input');
      const bInput = document.getElementById('note-body-input');
      const topic = tInput.value.trim();
      const body = bInput.value.trim();

      if (!topic || !body) {
        showToast("⚠️ Lütfen konu başlığı ve açıklama gir.");
        return;
      }

      const now = new Date();
      const dateStr = `${now.getDate().toString().padStart(2, '0')}.${(now.getMonth()+1).toString().padStart(2, '0')} ${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;

      notesDatabase.push({ topic, body, date: dateStr });
      localStorage.setItem(STORAGE_KEY_NOTES, JSON.stringify(notesDatabase));

      tInput.value = '';
      bInput.value = '';
      renderNotes();
      showToast("📝 Yanlış defterine eklendi!");
    }

    function deleteNote(index) {
      notesDatabase.splice(index, 1);
      localStorage.setItem(STORAGE_KEY_NOTES, JSON.stringify(notesDatabase));
      renderNotes();
      showToast("Not silindi.");
    }

    function shareSingleNoteTelegram(idx) {
      const n = notesDatabase[idx];
      if (!n) return;
      const text = `📝 *TYT YANLIŞ DEFTERİ*\n\n📌 *Konu:* ${n.topic}\n💡 *Açıklama:* ${n.body}\n📅 *Tarih:* ${n.date}`;
      window.open(`https://t.me/share/url?url=${encodeURIComponent(window.location.href)}&text=${encodeURIComponent(text)}`, '_blank');
    }

    function sendNotesToTelegram() {
      if (notesDatabase.length === 0) {
        showToast("⚠️ Gönderilecek not bulunmuyor.");
        return;
      }
      let full = `📝 *TYT YANLIŞ DEFTERİ - TÜM ANALİZLERİM*\n\n`;
      notesDatabase.forEach((n, i) => {
        full += `${i+1}) *${n.topic}* (${n.date}):\n${n.body}\n\n`;
      });
      window.open(`https://t.me/share/url?url=${encodeURIComponent(window.location.href)}&text=${encodeURIComponent(full)}`, '_blank');
      showToast("✈️ Notlar Telegram'a aktarılıyor...");
    }

    function toggleModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) modal.classList.toggle('hidden');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-message');
      if (!toast || !toastMsg) return;
      toastMsg.innerText = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toast.classList.add('opacity-100');
      setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 3000);
    }

    function escapeHtml(text) {
      if (!text) return '';
      const d = document.createElement('div');
      d.innerText = text;
      return d.innerHTML;
    }
  </script>
</body>
</html>
