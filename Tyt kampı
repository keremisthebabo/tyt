    function getLessonForSlot(globalSlotIndex) {
      if (offDaysDatabase[globalSlotIndex]) {
        return { isOffDay: true, offInfo: offDaysDatabase[globalSlotIndex] };
      }

      let shiftsBefore = 0;
      for (let i = 0; i < globalSlotIndex; i++) {
        if (offDaysDatabase[i]) shiftsBefore++;
      }

      const effectiveLessonIndex = globalSlotIndex - shiftsBefore;

      if (effectiveLessonIndex >= 0 && effectiveLessonIndex < linearCurriculum.length) {
        return {
          isOffDay: false,
          lesson: linearCurriculum[effectiveLessonIndex],
          effectiveIndex: effectiveLessonIndex
        };
      } else {
        return {
          isOffDay: false,
          lesson: {
            subj: "Genel Tekrar & Deneme",
            topic: "16 Haftalık Kamp Tamamlandı! 12. Sınıfa Geçiş Denemeleri",
