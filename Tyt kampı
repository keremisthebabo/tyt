<!DOCTYPE html>
<html lang="tr" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>TYT 16 Haftalık Spor & Okul Entegre Makro Kampı</title>
  
  <meta name="theme-color" content="#0a0f1d">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="TYT Kampı">
  <meta name="mobile-web-app-capable" content="yes">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
          },
          colors: {
            canvas: '#0a0f1d',
            cardbg: '#131b2e',
            cardhover: '#1a243d',
            borderclr: '#1e2c47'
          }
        }
      }
    }
  </script>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    html, body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #0a0f1d !important;
      color: #f1f5f9;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      width: 100%;
      min-height: 100%;
      margin: 0;
      padding: 0;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0a0f1d; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #334155; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    @keyframes pulseRing {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .alarm-ring {
      animation: pulseRing 1.4s ease-in-out infinite;
    }
  </style>
</head>
<body class="bg-[#0a0f1d] text-slate-100 min-h-screen flex flex-col antialiased relative">

  <!-- Sağ Alt Hızlı Erişim Butonları -->
  <div class="fixed bottom-5 right-5 z-40 flex flex-col gap-2.5 items-end">
    <!-- Ertelenen Dersler Kuyruğu Butonu -->
    <button onclick="toggleModal('shifted-lessons-modal')" id="shifted-queue-btn" class="group flex items-center gap-2 bg-gradient-to-r from-amber-600 to-rose-600 hover:from-amber-500 hover:to-rose-500 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-full shadow-xl shadow-rose-500/25 border border-rose-300/30 transition-all transform active:scale-95 hover:scale-105">
      <span>🏖️</span>
      <span class="tracking-wide">Zincirleme Kaydırma (<span id="shifted-count-badge">0</span> Gün)</span>
    </button>

    <!-- Saatlik Rutin Butonu -->
    <button onclick="openHourlyModal()" class="group flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-full shadow-xl shadow-amber-500/25 border border-amber-300/30 transition-all transform active:scale-95 hover:scale-105">
      <span>⏱️</span>
      <span class="tracking-wide">Spor & Saatlik Rutin</span>
    </button>

    <!-- 16 Haftalık Harita Butonu -->
    <button onclick="toggleModal('full-roadmap-modal')" class="group flex items-center gap-2 bg-gradient-to-r from-sky-500 via-indigo-600 to-purple-600 hover:from-sky-400 hover:to-indigo-500 text-white font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-full shadow-2xl shadow-sky-500/30 border border-sky-300/30 transition-all transform active:scale-95 hover:scale-105">
      <span>🗺️</span>
      <span class="tracking-wide">16 Haftalık Makro Harita</span>
    </button>
  </div>

  <!-- Üst Menü / Navbar -->
  <header class="sticky top-0 z-30 bg-[#0a0f1d]/95 backdrop-blur-md border-b border-[#1e2c47]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
      
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 via-indigo-600 to-purple-600 flex items-center justify-center font-black text-lg text-white shadow-lg shadow-sky-500/20 shrink-0">
          ⚡
        </div>
        <div class="truncate">
          <div class="flex items-center gap-2">
            <h1 class="text-sm sm:text-base font-bold text-white tracking-tight truncate">TYT 16 Haftalık Makro Kamp</h1>
            <span class="hidden sm:inline-block text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 font-bold">Spor, Teşvik & Maarif</span>
          </div>
          <p class="text-[11px] text-slate-400 truncate">Upper/Lower &bull; Dershane Senkronlu &bull; Otomatik Ders Kaydırma</p>
        </div>
      </div>
      
      <div class="flex items-center gap-2 shrink-0">
        <!-- Teşvik Bildirimi / Motivasyon Butonu -->
        <button onclick="triggerImmediateMotivation()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-purple-500/15 hover:bg-purple-500/25 text-purple-300 text-xs font-semibold border border-purple-500/30 transition shadow-sm" title="Bana Teşvik Gönder">
          <span>🔥</span> <span class="hidden sm:inline">Teşvik</span> Ateşle
        </button>

        <!-- Saatlik Plan Tuşu -->
        <button onclick="openHourlyModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-orange-500/15 hover:bg-orange-500/25 text-orange-400 text-xs font-semibold border border-orange-500/30 transition shadow-sm">
          <span>🏋️‍♂️</span> <span class="hidden sm:inline">Saatlik</span> Rutin
        </button>

        <!-- Dahili Alarm Ayar Butonu -->
        <button onclick="toggleModal('alarm-settings-modal')" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 text-xs font-semibold border border-amber-500/30 transition shadow-sm">
          <span id="nav-alarm-icon" class="animate-bounce">⏰</span>
          <span id="nav-alarm-text">08:00</span>
        </button>

        <!-- Telegram Paylaşım Butonu -->
        <button onclick="shareActiveWeekTelegram()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#229ED9]/15 hover:bg-[#229ED9]/25 text-[#229ED9] text-xs font-semibold border border-[#229ED9]/35 transition">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.18 3.35-1.39 3.73-1.39.08 0 .27.02.39.12.1.08.13.2.14.28-.01.06-.01.19-.03.39z"/></svg>
          <span class="hidden sm:inline">Haftayı</span> Telegram'a At
        </button>
      </div>
    </div>
  </header>

  <!-- Canlı Motivasyon Bandı -->
  <section class="bg-gradient-to-r from-purple-900/40 via-indigo-900/30 to-sky-900/40 border-b border-[#1e2c47]/70 px-4 py-2">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2 min-w-0">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
        </span>
        <span class="font-bold text-purple-300 shrink-0">Günün Teşviki:</span>
        <span id="live-motivation-text" class="text-slate-200 truncate italic">"11. sınıfta TYT'yi bitiren, 12. sınıfta sınavın efendisi olur!"</span>
      </div>
      <button onclick="generateRandomMotivation()" class="text-slate-400 hover:text-purple-300 font-semibold shrink-0 text-[11px] underline">
        Yenile ↻
      </button>
    </div>
  </section>

  <!-- Ana Gövde -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-5 space-y-6">

    <!-- Makro İlerleme ve Haftalık Bilgi Paneli -->
    <section class="bg-[#131b2e] border border-[#1e2c47] rounded-2xl p-5 sm:p-6 shadow-xl relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-center relative z-10">
        <div class="lg:col-span-2 space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span id="current-phase-badge" class="text-[11px] uppercase tracking-wider font-extrabold text-sky-400 bg-sky-500/10 border border-sky-500/25 px-2.5 py-0.5 rounded-md">
              Aşama 1: Temel İnşa & Sayılar
            </span>
            <span class="bg-orange-500/10 text-orange-400 border border-orange-500/25 text-[11px] px-2.5 py-0.5 rounded-md font-semibold flex items-center gap-1">
              <span>💪</span> Upper/Lower Rutinli
            </span>
            <span id="alarm-status-pill" class="bg-amber-500/15 text-amber-400 border border-amber-500/30 text-[11px] px-2.5 py-0.5 rounded-md font-semibold flex items-center gap-1">
              <span>🔔</span> Alarm Aktif: 08:00
            </span>
            <span id="shifted-header-badge" class="hidden bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[11px] px-2.5 py-0.5 rounded-md font-semibold flex items-center gap-1">
              <span>⚡</span> Zincirleme Kaydırma Aktif (0 Gün)
            </span>
          </div>
          <h2 id="active-week-title" class="text-xl sm:text-2xl font-black text-white tracking-tight">
            1. Hafta: Temel Kavramlar & Anlam Bilgisi
          </h2>
          <p id="active-week-desc" class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-2xl">
            Sayı kümelerini kavrama, okuduğunu anlama hızını artırma ve temel fen kavramlarını zihinde somutlaştırma dönemi.
          </p>
        </div>

        <div class="bg-[#0b101c] border border-[#1e2c47] rounded-xl p-4 sm:p-5 flex flex-col justify-between space-y-4">
          <div>
            <div class="flex justify-between items-end mb-1.5 text-xs">
              <span class="text-slate-400 font-medium">Genel TYT Başarısı (112 Gün):</span>
              <span id="macro-percent" class="font-black text-emerald-400 text-sm">0%</span>
            </div>
            <!-- Segmented Makro İlerleme Çubuğu -->
            <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden flex">
              <div id="macro-bar-fill-done" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 transition-all duration-500" style="width: 0%" title="Tamamlanan Dersler"></div>
              <div id="macro-bar-fill-shifted" class="h-full bg-gradient-to-r from-rose-500 to-red-600 transition-all duration-500" style="width: 0%" title="Kaydırılan Günler"></div>
            </div>
            <div class="flex flex-wrap justify-between items-center mt-2 text-[11px] gap-y-1">
              <span class="text-emerald-400 font-semibold flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
                <span id="macro-done-count">0</span> Tamamlandı
              </span>
              <span class="text-rose-400 font-semibold flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-rose-500 inline-block"></span>
                <span id="macro-shifted-count">0</span> Kaydırıldı
              </span>
              <span class="text-slate-500 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-slate-700 inline-block"></span>
                <span id="macro-remaining-count">112</span> Kalan
              </span>
            </div>
          </div>

          <div class="pt-2 border-t border-[#1e2c47]/70">
            <div class="flex justify-between items-end mb-1 text-xs">
              <span class="text-slate-400 font-medium">Bu Haftaki Durum:</span>
              <span id="week-percent" class="font-bold text-emerald-400">0%</span>
            </div>
            <!-- Segmented Haftalık İlerleme Çubuğu -->
            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden flex">
              <div id="week-bar-fill-done" class="h-full bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
              <div id="week-bar-fill-shifted" class="h-full bg-rose-500 transition-all duration-300" style="width: 0%"></div>
            </div>
            <div class="flex justify-between items-center mt-1.5 text-[10px] text-slate-400">
              <span id="week-details-text">0 Bitti • 0 Kaydırıldı</span>
              <span id="week-remaining-text">7 Gün Kalan</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 16 Haftalık Seçici Butonlar -->
    <section class="space-y-2">
      <div class="flex items-center justify-between">
        <h3 class="text-xs sm:text-sm font-bold text-slate-300 flex items-center gap-1.5">
          <span>🗓️</span> Kamp Haftasını Seç (1 - 16):
        </h3>
        <div class="flex items-center gap-2">
          <span class="text-[11px] text-slate-500 hidden sm:inline">Oklarla kaydır veya sürükle</span>
          <div class="flex items-center gap-1">
            <button onclick="scrollWeeks(-240)" title="Geri Kaydır" class="w-7 h-7 rounded-lg bg-[#131b2e] hover:bg-slate-700 border border-[#1e2c47] text-slate-300 flex items-center justify-center text-xs font-bold transition active:scale-90">
              ◀
            </button>
            <button onclick="scrollWeeks(240)" title="İleri Kaydır" class="w-7 h-7 rounded-lg bg-[#131b2e] hover:bg-slate-700 border border-[#1e2c47] text-slate-300 flex items-center justify-center text-xs font-bold transition active:scale-90">
              ▶
            </button>
          </div>
        </div>
      </div>

      <!-- Hafta Butonları Kaydırma Kapsayıcısı -->
      <div class="relative group">
        <div id="week-tabs-container" class="flex gap-2 overflow-x-auto pb-2.5 pt-0.5 px-0.5 scroll-smooth select-none cursor-grab active:cursor-grabbing" style="scrollbar-width: thin; scrollbar-color: #334155 #0a0f1d;">
          <!-- 16 hafta dinamik render edilecek -->
        </div>
      </div>
    </section>

    <!-- Seçili Haftanın 7 Günlük Kartları -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h3 id="week-header-label" class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <span>📅</span> 1. Hafta Günlük Ders Akışı & Spor Entegresi
          </h3>
          <p class="text-xs text-slate-400">Dışarı çıktıysan turuncu tuşa bas; domino etkisiyle tüm dersler sonraki güne kayar, asla üst üste yığılma olmaz.</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <button onclick="openHourlyModal()" class="px-3.5 py-1.5 rounded-xl bg-orange-500/20 hover:bg-orange-500/30 text-orange-300 border border-orange-500/30 text-xs font-semibold flex items-center gap-1.5 transition">
            <span>⏱️</span> Haftalık Saatlik Rutini Aç
          </button>
          <button onclick="resetCurrentWeek()" class="px-3 py-1.5 rounded-xl bg-slate-800/80 hover:bg-slate-800 text-slate-300 border border-slate-700 text-xs font-semibold transition">
            🔄 Bu Haftayı Sıfırla
          </button>
        </div>
      </div>

      <!-- Günlük Kartlar Grid -->
      <div id="active-days-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- JS ile 7 gün basılacak -->
      </div>
    </section>

    <!-- Yanlış Defteri / Çözüm Analizi -->
    <section class="bg-[#131b2e] border border-[#1e2c47] rounded-2xl p-5 sm:p-6 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 border-b border-[#1e2c47] pb-4">
        <div>
          <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <span>📝</span> Dijital Yanlış Defteri & Çıkarım Notları
          </h3>
          <p class="text-xs text-slate-400">Özel derslerde, okulda veya denemelerde takıldığın soru kalıplarını kaydet, Pazar günü tara.</p>
        </div>
        <button onclick="sendNotesToTelegram()" class="px-3 py-1.5 rounded-xl bg-[#229ED9]/15 hover:bg-[#229ED9]/25 text-[#229ED9] text-xs font-semibold border border-[#229ED9]/30 flex items-center gap-1.5 transition self-start sm:self-auto">
          <span>📤</span> Notları Telegram'a Aktar
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <div class="space-y-3">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Ders & Konu Başlığı</label>
            <input id="note-topic-input" type="text" placeholder="Örn: Pazartesi Fizik Özel Dersi / Mert Hoca Mat" class="w-full bg-[#0b101c] border border-[#1e2c47] rounded-xl px-3.5 py-2.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-sky-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Hata Analizi ve Çıkarılan Formül/Taktik</label>
            <textarea id="note-body-input" rows="4" placeholder="Sürtünmeli düzlemde F-k.N bağıntısında normal kuvveti alırken eğik düzlem açısına dikkat..." class="w-full bg-[#0b101c] border border-[#1e2c47] rounded-xl px-3.5 py-2.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-sky-500 resize-none"></textarea>
          </div>
          <button onclick="addMistakeNote()" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white font-semibold text-xs transition shadow-md shadow-sky-500/20">
            ➕ Yanlış Defterine Ekle
          </button>
        </div>

        <div class="lg:col-span-2">
          <div class="text-xs font-semibold text-slate-400 mb-2.5 flex justify-between items-center">
            <span>Kayıtlı Soru Analizlerin</span>
            <span id="saved-notes-count" class="text-slate-500">0 Not</span>
          </div>
          <div id="notes-container" class="space-y-3 max-h-[300px] overflow-y-auto pr-1">
            <!-- Dinamik notlar -->
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ================= MODALLAR ================= -->

  <!-- 1. ERTELENEN / DIŞARI ÇIKILAN DERSLER LİSTESİ MODALI -->
  <div id="shifted-lessons-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-5">
    <div class="bg-[#131b2e] border border-[#1e2c47] rounded-3xl max-w-2xl w-full p-5 sm:p-7 shadow-2xl relative max-h-[92vh] flex flex-col">
      <div class="flex items-center justify-between pb-4 border-b border-[#1e2c47]">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 to-rose-600 text-white flex items-center justify-center text-xl font-bold shadow-md shadow-rose-500/20">
            ⚡
          </div>
          <div>
            <h4 class="text-base sm:text-lg font-black text-white">Zincirleme Kaydırılan Günler (Domino Çizelgesi)</h4>
            <p class="text-xs text-slate-400">Dışarı çıktığın günler dinlenme olarak işaretlenir; kalan müfredat sonraki günlere kayarak derslerin çakışmasını engeller.</p>
          </div>
        </div>
        <button onclick="toggleModal('shifted-lessons-modal')" class="text-slate-400 hover:text-white p-2 rounded-lg bg-slate-800/60 hover:bg-slate-800 transition">✕</button>
      </div>

      <div class="overflow-y-auto flex-1 my-4 pr-1 space-y-3" id="shifted-lessons-container">
        <!-- JS ile ertelenen günler doldurulacak -->
      </div>

      <div class="pt-4 border-t border-[#1e2c47] flex items-center justify-between gap-3 text-xs">
        <span class="text-slate-400">💡 Bir günün kaydırmasını geri aldığında tüm müfredat otomatik olarak 1 gün geriye çekilir.</span>
        <button onclick="toggleModal('shifted-lessons-modal')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-semibold transition">
          Kapat
        </button>
      </div>
    </div>
  </div>

  <!-- 2. SPOR & SAATLİK RUTİN MODALI -->
  <div id="hourly-routine-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-5">
    <div class="bg-[#131b2e] border border-[#1e2c47] rounded-3xl max-w-4xl w-full p-5 sm:p-7 shadow-2xl relative max-h-[92vh] flex flex-col">
      <div class="flex items-center justify-between pb-4 border-b border-[#1e2c47]">
        <div class="flex items-center gap-3">
